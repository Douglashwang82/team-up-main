{
  "name": "@teamup/mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for TeamUp API - enables AI assistants to interact with TeamUp",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "teamup-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/inspector": "^0.19.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.11",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "mcp",
    "teamup",
    "api",
    "ai",
    "claude"
  ]
}
